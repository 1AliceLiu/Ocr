# Copy this file to .env and fill in the real values.
#   cp .env.example .env      (Linux/macOS)
#   Copy-Item .env.example .env   (Windows PowerShell)
# .env is ignored by git and must be created separately on the server.

API_KEY=change-me
API_PORT=8000
MONITOR_INTERVAL=60

# Platform account used by scripts/evo_pull.py and scripts/evo_osd_monitor.py.
EVO_BASE=https://your-platform:8092
EVO_USER=system
EVO_PASSWORD=change-me
OSD_INTERVAL=60
